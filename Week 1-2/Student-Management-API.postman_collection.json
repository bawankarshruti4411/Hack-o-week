{
  "info": {
    "name": "Student Management API",
    "description": "Postman collection for testing the Student Management REST API. Base URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get All Students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Returns the full list of students. Expected status: 200 OK"
      },
      "response": []
    },
    {
      "name": "2. Get Student By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        },
        "description": "Returns a single student with id 1. Expected status: 200 OK"
      },
      "response": []
    },
    {
      "name": "3. Get Student By Invalid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/9999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "9999"]
        },
        "description": "Tries to fetch a student that does not exist. Expected status: 404 Not Found"
      },
      "response": []
    },
    {
      "name": "4. Create Student (Valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Neha Singh\",\n  \"department\": \"CSE\",\n  \"year\": 3,\n  \"email\": \"neha@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Creates a new student with a valid request body. Expected status: 201 Created"
      },
      "response": []
    },
    {
      "name": "5. Create Student (Invalid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Missing Fields\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        },
        "description": "Attempts to create a student with missing required fields. Expected status: 400 Bad Request"
      },
      "response": []
    },
    {
      "name": "6. Update Student (Valid)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma Updated\",\n  \"department\": \"CSE\",\n  \"year\": 4,\n  \"email\": \"rahul.updated@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        },
        "description": "Updates the student with id 1 using valid data. Expected status: 200 OK"
      },
      "response": []
    },
    {
      "name": "7. Update Student (Invalid)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ghost Student\",\n  \"department\": \"CSE\",\n  \"year\": 2,\n  \"email\": \"ghost@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/9999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "9999"]
        },
        "description": "Attempts to update a student that does not exist. Expected status: 404 Not Found"
      },
      "response": []
    },
    {
      "name": "8. Delete Student (Valid)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/2",
          "host": ["{{baseUrl}}"],
          "path": ["students", "2"]
        },
        "description": "Deletes the student with id 2. Expected status: 200 OK"
      },
      "response": []
    },
    {
      "name": "9. Delete Student (Invalid)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/9999",
          "host": ["{{baseUrl}}"],
          "path": ["students", "9999"]
        },
        "description": "Attempts to delete a student that does not exist. Expected status: 404 Not Found"
      },
      "response": []
    },
    {
      "name": "10. Get Unknown Route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/unknown-route",
          "host": ["{{baseUrl}}"],
          "path": ["unknown-route"]
        },
        "description": "Requests a route that does not exist in the API. Expected status: 404 Not Found"
      },
      "response": []
    }
  ]
}
